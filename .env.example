# ── 本番 URL ──────────────────────────────────────────────
# 通常は設定不要です。
# Vercel の本番デプロイでは、next.config.ts の PRODUCTION_URL
# （https://www.nipporisharebase.com）が自動で使われ、canonical・sitemap・OG・構造化データに入ります。
# プレビューとローカルでは空になり、全ページ noindex になります（プレビュー URL が検索に出ないため）。
#
# 一時的に別の URL で公開したいときだけ、Production 環境に設定してください（末尾のスラッシュなし）。
# Preview 環境には設定しないこと。
NEXT_PUBLIC_SITE_URL=

# ── Google Search Console ─────────────────────────────────
# 所有権確認（HTML タグ方式）の content の値だけを入れます。
# 例: <meta name="google-site-verification" content="abc123" /> なら abc123
# 空のままならタグは出力されません。設定したら再デプロイが必要です。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Google アナリティクス（GA4） ──────────────────────────
# 通常は設定不要です（測定 ID は components/layout/Analytics.tsx に書いてあります）。
# 別の GA4 プロパティに切り替えたいときだけ、測定 ID（G-XXXXXXXXXX）を Production 環境に設定します。
# プレビューとローカルでは、値があっても読み込みません。
NEXT_PUBLIC_GA_ID=
