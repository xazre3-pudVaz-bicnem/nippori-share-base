# 本番の URL（末尾のスラッシュなし）。
# これを設定するまで、canonical・OG の URL・sitemap は出力されず、全ページが noindex になります。
# 独自ドメインが決まったら、ホスティング（Vercel など）の「Production」環境だけに設定してください。
# プレビュー環境には設定しないこと（プレビューが検索結果に出るのを防ぐため）。
NEXT_PUBLIC_SITE_URL=

# Google Search Console の所有権確認コード（HTML タグ方式の content の値）。任意。
GOOGLE_SITE_VERIFICATION=
